# Postgres
POSTGRES_USER=unclaimed
POSTGRES_PASSWORD=changeme
POSTGRES_DB=unclaimed
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full connection string used by SQLAlchemy (sync, ingestion + table creation).
# The API derives its async variant (postgresql+asyncpg://) from this automatically —
# see db/config.py — so only this one URL needs to be set.
DATABASE_URL=postgresql://unclaimed:changeme@db:5432/unclaimed

# Mobility Database API (https://mobilitydatabase.org)
# Get a free refresh token from your account at mobilitydatabase.org — see
# README.md / the manual steps list for exactly where. ingestion/mobility_db.py
# exchanges this for a short-lived access token at request time.
MOBILITY_API_TOKEN=

# Optional overrides — sensible defaults are baked into db/config.py, only set
# these if you need to point at something other than the real, public services.
MOBILITY_API_BASE_URL=https://api.mobilitydatabase.org/v1
TRANSIT_REGIONS_URL=https://transitapp.com/region
REST_COUNTRIES_BASE_URL=https://restcountries.com/v3.1

# Match confidence threshold (0-100) above which a mobility agency is
# considered covered by Transit app (Step 4).
MATCH_CONFIDENCE_THRESHOLD=85

# API
API_PORT=8000
